#!/bin/bash
set -eo pipefail

if ((BASH_VERSINFO[0] < 4)); then
	echo "ERROR: OMW requires Bash 4 or newer. Current Bash: ${BASH_VERSION:-unknown}" >&2
	exit 2
fi

_omw_cli_resolve_script_dir() {
	local script_path="$1"
	local dir
	local link

	while [[ -L "$script_path" ]]; do
		dir=$(builtin cd -P "$(dirname "$script_path")" && builtin pwd)
		link=$(readlink "$script_path")
		if [[ "$link" == /* ]]; then
			script_path="$link"
		else
			script_path="$dir/$link"
		fi
	done

	builtin cd -P "$(dirname "$script_path")" && builtin pwd
}

OMW_HOME=$(_omw_cli_resolve_script_dir "${BASH_SOURCE[0]}")
OMW_VERSION_FILE="$OMW_HOME/VERSION"
if [[ -f "$OMW_VERSION_FILE" ]]; then
	OMW_VERSION=$(tr -d '[:space:]' <"$OMW_VERSION_FILE")
else
	OMW_VERSION="0.0.0-dev"
fi
[[ -n "$OMW_VERSION" ]] || OMW_VERSION="0.0.0-dev"
export OMW_HOME
export OMW_VERSION
unset -f _omw_cli_resolve_script_dir

declare -a SOFTWARE_LIST SOFTWARE_BUILD_ALL_EXCLUDES APP_LIST NODE_PACKAGE_LIST NODE_CACHE_PACKAGE_LIST CONFIG_BACKUP_PATHS CONFIG_TARGET_LIST
declare -a OMW_TX_TMP_PATHS OMW_TX_INTERNAL_PATHS OMW_TX_INTERNAL_BACKUPS OMW_TX_EXTERNAL_PATHS OMW_TX_EXTERNAL_BACKUPS
declare -A SOFTWARE_VERSIONS SOFTWARE_URLS SOFTWARE_DEPS SOFTWARE_CONFIG_CMDS SOFTWARE_CFLAGS SOFTWARE_LDFLAGS
declare -A APP_VERSIONS APP_URLS APP_EXECUTABLE_NAME APP_SOURCE_URLS APP_BIN_DIRS
declare -A NODE_PACKAGE_NAMES NODE_PACKAGE_VERSIONS NODE_PACKAGE_BINS NODE_PACKAGE_NODE_VERSIONS
declare -A NODE_CACHE_PACKAGE_NAMES NODE_CACHE_PACKAGE_VERSIONS NODE_CACHE_PACKAGE_NODE_VERSIONS

_omw_cli_handle_exit() {
	local status=$?
	if declare -F omw_tx_rollback >/dev/null; then
		omw_tx_rollback
	fi
	return "$status"
}
trap '_omw_cli_handle_exit' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

_omw_cli_source_module() {
	local module="$1"
	local path="$OMW_HOME/lib/$OMW_VERSION/$module"

	if [[ ! -f "$path" ]]; then
		path="$OMW_HOME/lib/$module"
	fi
	if [[ ! -f "$path" ]]; then
		echo "ERROR: OMW module not found: lib/$OMW_VERSION/$module or lib/$module" >&2
		exit 2
	fi
	# shellcheck source=/dev/null
	source "$path"
}

_omw_cli_source_module "common.sh"
_omw_cli_source_module "fs.sh"
_omw_cli_source_module "tx.sh"
_omw_cli_source_module "registry.sh"
_omw_cli_source_module "status.sh"
_omw_cli_source_module "build.sh"
_omw_cli_source_module "app.sh"
_omw_cli_source_module "node.sh"
_omw_cli_source_module "config.sh"
_omw_cli_source_module "offline.sh"
_omw_cli_source_module "upgrade.sh"
_omw_cli_source_module "workflow.sh"
_omw_cli_source_module "doctor.sh"
_omw_cli_source_module "cli.sh"

main() {
	_omw_cli_parse "$@"
	if _omw_cli_is_meta_command; then
		_omw_cli_run_command
		return
	fi
	omw_init_globals
	_omw_cli_check_sys_deps
	_omw_cli_run_command
}

main "$@"
